[Unit]
Description=Personal Assistant backend Docker service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=dok
Group=dok
ExecStart=/usr/bin/docker start personal-assistant-backend
ExecReload=/usr/bin/docker restart personal-assistant-backend
ExecStop=/usr/bin/docker stop --time 30 personal-assistant-backend
TimeoutStartSec=60
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
